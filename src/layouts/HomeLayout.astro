---
import BaseLayout from "@layouts/BaseLayout.astro";

import { schemas, type SchemaKey } from '../data/schema';

const { frontmatter, jsonLd } = Astro.props;
const schemaKey = frontmatter?.schema as SchemaKey | undefined;
const pageSchema = jsonLd ?? (schemaKey ? schemas[schemaKey] : undefined);

---

<BaseLayout pageTitle={frontmatter.title} jsonLd={pageSchema}>
  <slot />
</BaseLayout>
